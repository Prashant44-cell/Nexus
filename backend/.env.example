APP_ENV=production
DEMO_MODE=true
PUBLIC_SIGNUP_ENABLED=false
WEB3_DEMO_AUTH_ENABLED=false
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_TTL_MINUTES=60
# Same-origin full-stack deployment does not require browser CORS. Set this only
# when a different browser origin must call the API.
CORS_ORIGINS=https://nexus-blockbank.onrender.com
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_USER_PASSWORD=replace-with-a-strong-demo-user-password
HOST=0.0.0.0
PORT=8000
